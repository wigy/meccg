{
  "name": "@meccg/lobby-server",
  "version": "0.74.0",
  "private": true,
  "scripts": {
    "build": "tsc && npm run build:browser",
    "build:browser": "esbuild src/browser/bundle.ts src/browser/game-bundle.ts src/browser/deck-editor-bundle.ts --bundle --outdir=public --entry-names=[name] --format=iife --platform=browser",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build:browser && npx tsx src/server.ts",
    "dev": "npm run build:browser -- --watch=forever & npx tsx watch --clear-screen=false --tsconfig tsconfig.dev.json src/server.ts --dev"
  },
  "dependencies": {
    "@meccg/shared": "*",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
