{
  "name": "@meccg/lobby-server",
  "version": "0.213.0",
  "private": true,
  "scripts": {
    "build": "tsc && npm run build:browser",
    "build:browser": "esbuild src/browser/bundle.ts src/browser/game-bundle.ts src/browser/deck-editor-bundle.ts --bundle --outdir=public --entry-names=[name] --format=iife --platform=browser",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build:browser && npx tsx src/server.ts",
    "dev": "npm run build:browser -- --watch=forever & nodemon --watch src --ignore src/browser --watch ../shared/src --ext ts,json --exec 'npx tsx --tsconfig tsconfig.dev.json src/server.ts --dev'"
  },
  "dependencies": {
    "@meccg/game-server": "*",
    "@meccg/shared": "*",
    "nodemailer": "^10.1.7",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.25.0"
  }
}
