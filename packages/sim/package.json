{
  "name": "@meccg/sim",
  "version": "0.1.0",
  "private": true,
  "description": "Headless in-process simulation harness for MECCG: agents, self-play runner, statistics, replays",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "bench": "npx tsx src/cli/bench.ts",
    "play": "npx tsx src/cli/play.ts",
    "replay": "npx tsx src/cli/replay.ts",
    "tournament": "npx tsx src/cli/tournament.ts",
    "gate": "npx tsx src/cli/gate.ts",
    "export-training": "npx tsx src/cli/export.ts",
    "qualify": "npx tsx src/cli/qualify.ts",
    "explain": "npx tsx src/cli/explain.ts",
    "scenarios": "npx tsx src/cli/scenarios.ts",
    "fit-winprob": "npx tsx src/cli/fit-winprob.ts",
    "calibrate": "npx tsx src/cli/calibrate.ts",
    "compare": "npx tsx src/cli/compare.ts",
    "sweep": "npx tsx src/cli/sweep.ts",
    "horizon": "npx tsx src/cli/horizon.ts",
    "coverage": "npx tsx src/cli/coverage.ts",
    "hand-flow": "npx tsx src/cli/hand-flow.ts",
    "headtohead": "npx tsx src/cli/headtohead.ts",
    "mc-horizon-probe": "npx tsx src/cli/mc-horizon-probe.ts"
  },
  "dependencies": {
    "@meccg/shared": "*",
    "@meccg/game-server": "*"
  }
}
