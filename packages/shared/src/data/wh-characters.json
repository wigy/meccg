    "generalInfluence": 17,
    "marshallingPoints": 0,
    "marshallingCategory": "character",
    "homesite": "Any non-“Dragon’s lair” Ruins & Lairs in a Wilderness",
    "effects": [
      {
        "type": "fw-kill-mp-full"
      },
      {
        "type": "detainment-attacks-normal",
        "stagePointsAbove": 7
      },
      {
        "type": "on-event",
        "event": "creature-attack-begins",
        "apply": {
          "type": "offer-char-join-attack",
          "discardOwnedAllies": true,
          "forceStrike": true,
          "postAttack": {
            "tapIfUntapped": true,
            "corruptionCheck": {}
          }
        }
      }
    ],
    "certified": "2026-07-08"
  },
