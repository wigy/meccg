  {
    "cardType": "hero-character",
    "id": "wh-1",
    "name": "Alatar",
    "image": "https://raw.githubusercontent.com/council-of-rivendell/meccg-remaster/master/en-remaster/wh/Alatar.jpg",
    "text": "Unique. Hazards your companies defeat (even with *) are worth full kill marshalling points. If you have more than 7 stage points, all detainment attacks against your companies attack normally instead. If at one of his Wizardhavens [{H}] when a hazard creature attacks one of your companies, he may immediately join that company (discard allies he controls). Alatar must face a strike from the creature (in all cases). Following all of the creature’s attacks, Alatar must tap (if untapped) and make a corruption check.",
    "alignment": "fallen-wizard",
    "unique": true,
    "race": "fallen-wizard",
    "skills": [
      "warrior",
      "scout",
      "ranger",
      "sage"
    ],
    "prowess": 7,
    "body": 9,
    "mind": null,
