#!/bin/bash
set -eo pipefail

# Make the worker self-sufficient about PATH. `gh` (and other user tools) live
# in ~/.local/bin, which only lands on PATH when a LOGIN shell sources
# ~/.profile. Launched from systemd/cron or any non-login context that skips the
# profile, the handle-mail skills (and the headless claude they run) could not
# find gh even though it was installed. Prepend it ourselves so run-ai works
# regardless of how it is started.
export PATH="$HOME/.local/bin:$PATH"

if [ $# -ge 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
  cat <<'EOF'
Usage: bin/run-ai [<n>]
       bin/run-ai <request-id> [<request-id>...]

Given one or more request IDs, run-ai works in ONE-SHOT mode: it handles
exactly those requests, in the order given, and then quits. One-shot mode skips
the polling loop — it only dispatches the named requests to bin/handle-mail.
It still refuses to start on a dirty working tree, and it still validates the
headless claude token first (failing immediately rather than waiting, since a
human is watching).

With no request IDs it is the long-running worker loop described below.

Long-running worker loop that polls for unhandled ai requests and
dispatches them to bin/handle-mail one at a time. Pulls master between
iterations and skips feature-requests (which require human review).

Requests are served by topic priority rather than arrival order: bug reports
first, then feature planning/implementation requests, then anything else
(card requests, review fixes), and certification requests last — so a large
certification backlog never delays a bug fix. Within one priority tier the
oldest request goes first. A request whose requestor has no credits left is
skipped (left 'new', so it resumes automatically after a top-up) and the
queue moves on to the next eligible request.

run-ai handles requests only. Open-PR maintenance (fixing conflicts, failing
CI and review comments on open PRs) and the finalize sweep that resolves
'processed' messages from their PR's merge/close outcome live in bin/pr-check,
a separate worker that can run alongside this one.

On startup it preflight-checks the headless claude OAuth token: it resolves
the token (env or secrets.json) and validates it with a tiny test prompt, so a
missing/expired token surfaces immediately instead of failing inside the first
request. If the token is unusable it prints setup instructions and then waits
on the idle-backoff schedule, re-checking until one works — it does not exit,
so dropping a valid token in resumes the worker without a restart. The token
cannot be created automatically — `claude setup-token` is interactive.

The loop is designed never to die on a recoverable error: a dirty working tree
pauses the worker (with the leftovers listed) until a human turns them into a
PR or reverts them; a handle-mail failure marks that one request 'failed' and
moves on to the next; an unusable token, an unreachable lobby, and an
unreachable git remote all back off and retry. Every curl/git-pull network
call is bounded by a timeout, so a hung remote cannot silently freeze the loop.
Only Ctrl+C/SIGTERM (130) and --max-iterations (0) stop it.

If handle-mail hits an API capacity/usage limit (subscription session limit,
rate limit, or server overload) mid-request, it resets that message to 'new'
(never burning it) and exits 5; run-ai treats 5 as retryable — it backs off on
the idle schedule and retries the same message later, once the limit resets,
instead of marching down the queue marking every request failed. Any other
non-zero exit is a genuine failure of that one request: run-ai forces the
message terminal ('failed') if the crashed handler left it 'new'/'processing',
so the queue cannot loop on it, then continues with the next request.

Ctrl+C (SIGINT) and SIGTERM are caught: any request that was in flight is reset
from 'processing' back to 'new' before exiting (code 130), so an interrupted
request is picked up again by the next run instead of being stranded as
'processing' forever.

Arguments:
  <n>             Optional maximum number of requests to handle, then exit.
                  (Loop mode; a bare number of at most 6 digits.)
  <request-id>    One or more ai-inbox message IDs (16 hex characters, as
                  listed by bin/requests or bin/handle-mail). Handles exactly
                  those requests and exits: 0 if all succeeded, 1 if any
                  failed, 5 if one was left unhandled by an API capacity limit
                  (that message stays 'new' and can be re-run later).

Environment:
  MECCG_LOBBY_URL   Lobby base URL (default http://localhost:8080)
  MECCG_MASTER_KEY  Lobby master key. Falls back to
                    ~/.meccg/secrets.json when unset.
  CLAUDE_CODE_OAUTH_TOKEN
                    Long-lived OAuth token (from `claude setup-token`) for the
                    headless claude. Falls back to `claudeOauthToken` in
                    ~/.meccg/secrets.json. Required so killing claude between
                    iterations does not invalidate the rotating subscription
                    token (which caused a 401 on every run after the first).

Options:
  -h, --help      Show this help message.
EOF
  exit 0
fi

# Two argument shapes share one positional slot, so they must be told apart
# unambiguously. Message IDs are 16 hex characters (crypto.randomBytes(8)), and
# roughly one in 1800 of those happens to be all digits — so "is it numeric?"
# alone is not a safe test. A short bare number (<= 6 digits) is the iteration
# cap; anything else is treated as a request ID.
MAX_ITERATIONS=""
REQUEST_IDS=()
if [ $# -eq 1 ] && [[ "$1" =~ ^[0-9]{1,6}$ ]]; then
  MAX_ITERATIONS="$1"
elif [ $# -ge 1 ]; then
  REQUEST_IDS=("$@")
fi

iterations=0

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG_DIR="$HOME/.meccg/logs"
LOG_FILE="$LOG_DIR/ai.log"
SECRETS="$HOME/.meccg/secrets.json"
BASE_URL="${MECCG_LOBBY_URL:-http://localhost:8080}"
BASE_URL="${BASE_URL%/}"

mkdir -p "$LOG_DIR"

# Bound every curl so an unresponsive (as opposed to down) lobby can't wedge
# the loop.
#
# On top of the timeout, retry connection-class failures. The lobby runs under
# nodemon in dev mode watching packages/lobby-server/src and packages/shared/src
# — paths this very worker rewrites on every checkout — so it restarts mid-run
# and calls landing in that window get ECONNREFUSED. Without a retry the sweep
# simply logged "failed to set message X -> failed" and moved on, leaving the
# message in whatever state it was in. Only connection-class codes are retried;
# an HTTP error from `-f` is returned on the first attempt so real 4xx/5xx
# responses are not hidden behind a minute of retries.
CURL_MAX_ATTEMPTS=12
CURL_RETRY_DELAY=5
curl() {
  local attempt=1 out rc
  while : ; do
    out=$(command curl --max-time 30 "$@") && rc=0 || rc=$?
    if [ "$rc" -eq 0 ]; then
      printf '%s' "$out"
      return 0
    fi
    case "$rc" in
      6|7|28|35|52|56) ;;   # DNS / connect / timeout / TLS / empty or broken reply
      *) printf '%s' "$out"; return "$rc" ;;
    esac
    if [ "$attempt" -ge "$CURL_MAX_ATTEMPTS" ]; then
      printf '%s' "$out"
      return "$rc"
    fi
    echo "[run-ai] lobby unreachable (curl exit $rc) — likely a dev-mode restart; retrying in ${CURL_RETRY_DELAY}s (attempt $attempt/$CURL_MAX_ATTEMPTS)" >&2
    sleep "$CURL_RETRY_DELAY"
    attempt=$(( attempt + 1 ))
  done
}

master_key() {
  if [ -n "${MECCG_MASTER_KEY:-}" ]; then
    echo "$MECCG_MASTER_KEY"
    return 0
  fi
  if [ -f "$SECRETS" ]; then
    jq -r .masterKey "$SECRETS"
    return 0
  fi
  echo "[run-ai] ERROR: no master key (set MECCG_MASTER_KEY or provide $SECRETS)" >&2
  return 1
}

# Normalize a player name to its on-disk directory name. Mirrors the
# toDirName logic in packages/lobby-server/src/players/store.ts (and
# handle-mail's to_dir_name).
to_dir_name() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g'
}

# Read a player's current credit balance via the lobby system API. Unknown
# players (the endpoint's 404) and unreadable responses count as 0, matching
# handle-mail's get_player_credits. Prints the integer balance.
requestor_credits() {
  local dir resp credits
  dir=$(to_dir_name "$1")
  resp=$(curl -sf -X GET "$BASE_URL/api/system/players/$dir/credits" \
    -H "Authorization: Bearer $(master_key)" 2>/dev/null) || resp=""
  credits=$(jq -r '.credits // 0' <<<"$resp" 2>/dev/null)
  if [ -z "$credits" ] || [ "$credits" = "null" ]; then credits=0; fi
  echo "$credits"
}

# PUT a status on a message in any inbox.  $1=inbox  $2=msg-id  $3=status
set_inbox_message_status() {
  curl -sf -X PUT "$BASE_URL/api/system/mail/$1/$2" \
    -H "Authorization: Bearer $(master_key)" \
    -H 'Content-Type: application/json' \
    -d "{\"status\":\"$3\"}" >/dev/null 2>&1 \
    || echo "[run-ai] WARNING: failed to set $1 message $2 -> $3" | tee -a "$LOG_FILE"
}

# PUT a status on an ai-inbox message.  $1=msg-id  $2=status
set_message_status() {
  set_inbox_message_status ai "$1" "$2"
}

# Print the current status of an ai-inbox message.  $1=msg-id
# Non-zero (and empty output) if the lobby could not be reached.
message_status() {
  local resp
  resp=$(curl -sf -X GET "$BASE_URL/api/system/ai-requests?all=true" \
    -H "Authorization: Bearer $(master_key)" 2>/dev/null) || return 1
  jq -r --arg id "$1" '[.requests[] | select(.id == $id)][0].status // empty' <<<"$resp" 2>/dev/null
}

# ---------------------------------------------------------------------------
# Interrupt handling
# ---------------------------------------------------------------------------
# handle-mail marks a message 'processing' the moment it starts. If the operator
# hits Ctrl+C (or something SIGTERMs us) mid-request, handle-mail dies with the
# message still 'processing' — a state nothing ever clears, so that request is
# stranded forever: never retried, never failed, invisible to the next run-ai.
# Catch the signal, reset the in-flight message back to 'new' (it was not
# handled, so it must not be burned), and exit 130. CURRENT_MSG_ID is set only
# for the window in which a message is actually in flight.
CURRENT_MSG_ID=""
HANDLE_PID=""

# TERM a process and everything below it, children first. Terminating only the
# direct child is not enough: the work runs in a grandchild (handle-mail spawns
# the headless claude), which would otherwise keep running — and keep writing to
# the repo — after we exit.
kill_tree() {
  local pid="$1" child
  for child in $(pgrep -P "$pid" 2>/dev/null); do
    kill_tree "$child"
  done
  kill -TERM "$pid" 2>/dev/null || true
}

on_interrupt() {
  local sig="$1"
  # Restore default handling: a second Ctrl+C during cleanup kills us outright
  # rather than re-entering this handler.
  trap - INT TERM

  echo | tee -a "$LOG_FILE"
  echo "=== Interrupted (SIG$sig) at $(date -Iseconds). Cleaning up. ===" | tee -a "$LOG_FILE"

  # Stop everything we spawned (handle-mail + its headless claude). A terminal
  # Ctrl+C already signalled the whole foreground process group, but an explicit
  # SIGTERM to run-ai alone did not — so do it ourselves either way.
  if [ -n "$HANDLE_PID" ]; then
    kill_tree "$HANDLE_PID"
  fi
  pkill -TERM -P $$ 2>/dev/null || true

  if [ -n "$CURRENT_MSG_ID" ]; then
    # Only rewind a message that is genuinely still in flight. If the signal
    # landed in the window where handle-mail had already recorded its outcome
    # (success / failed / processed-awaiting-PR, or its own reset to 'new'),
    # resetting on top of that would re-run finished work — so leave it alone.
    # An unreadable status (lobby down) is treated as still-processing: a reset
    # attempt that fails is harmless, a stranded 'processing' message is not.
    local st
    st=$(message_status "$CURRENT_MSG_ID" 2>/dev/null || true)
    if [ -n "$st" ] && [ "$st" != "processing" ]; then
      echo "=== Interrupted request $CURRENT_MSG_ID already resolved (status=$st); leaving it as-is ===" | tee -a "$LOG_FILE"
    else
      echo "=== Resetting interrupted request $CURRENT_MSG_ID to 'new' (not burned) ===" | tee -a "$LOG_FILE"
      set_message_status "$CURRENT_MSG_ID" new
    fi
    CURRENT_MSG_ID=""
  fi

  exit 130
}
trap 'on_interrupt INT' INT
trap 'on_interrupt TERM' TERM

# Hand one message to handle-mail and return ITS exit code (0 handled, 5 API
# capacity limit — message already reset to 'new' —, anything else a genuine
# failure of that request). Shared by the polling loop and one-shot mode.
#
# Run handle-mail as a BACKGROUND child and `wait` on it, rather than as a
# foreground `handle-mail | tee` pipeline. Two reasons:
#   - Signals: bash defers a trap until the current FOREGROUND command returns,
#     so with a foreground pipeline a SIGTERM aimed at run-ai alone would not
#     run on_interrupt until handle-mail finished on its own — i.e. not for
#     hours. `wait` is interruptible, so the trap fires immediately.
#   - Exit code: `wait` yields handle-mail's OWN status directly, with no
#     PIPESTATUS/pipefail juggling around tee. Logging still goes through tee
#     via process substitution.
# `|| rc=$?` also shields the non-zero case from `set -e`.
run_request() {
  local msg_id="$1" rc=0
  # In flight from here: an interrupt now must reset this message to 'new'
  # (handle-mail marks it 'processing' as its first act).
  CURRENT_MSG_ID="$msg_id"
  "$SCRIPT_DIR/handle-mail" "$msg_id" > >(tee -a "$LOG_FILE") 2>&1 &
  HANDLE_PID=$!
  wait "$HANDLE_PID" || rc=$?
  HANDLE_PID=""
  # handle-mail returned on its own; it owns the message's final status now.
  CURRENT_MSG_ID=""
  return "$rc"
}

# A crashed handler can leave its message 'new'/'processing' — a state the queue
# would pick up and fail on forever. Force it terminal.  $1=msg-id  $2=exit code
force_failed_if_unresolved() {
  local msg_id="$1" status_now
  status_now=$(message_status "$msg_id" 2>/dev/null || echo "")
  if [ -z "$status_now" ] || [ "$status_now" = "new" ] || [ "$status_now" = "processing" ]; then
    echo "[run-ai] $msg_id left in '${status_now:-unknown}' by a crashed handler; forcing 'failed' so the queue advances." | tee -a "$LOG_FILE"
    set_message_status "$msg_id" failed
  fi
}

# Fetch unhandled requests from the lobby system API and print the ID of the
# highest-priority handleable message. Feature-requests need human review
# (approve/decline) and cannot be auto-handled, so they are excluded.
#
# The queue is served by topic priority, not arrival order:
#   1. bug-report                    — broken behaviour blocks everyone; fix first
#   2. feature-planning-request /
#      feature-implementation-request — requested work
#   3. everything else (card-request, review-fix-request, ...) — small and rare;
#      kept above certification so a long certification backlog cannot starve them
#   4. certification-request          — the bulk backlog; drained last
# Within a tier the lobby's own order (oldest first) is preserved, because
# jq's sort_by is stable.
#
# A request whose requestor has a zero/negative credit balance is SKIPPED, not
# served: it stays 'new' (so it resumes by itself once the player tops up) and
# the queue moves on to the next eligible request. Without this skip the
# highest-priority credit-blocked message would be re-picked every tick and
# starve everything behind it (handle-mail's own credit gate leaves the message
# 'new'). The billed account is resolved exactly like handle-mail's Step 2b:
# keywords.originalRequestor, then keywords.userName, then the message's from;
# system accounts (ai/admin/server) are never billed and never gated.
#
# Returns non-zero if the lobby could not be reached (curl failure). The caller
# MUST distinguish this from an empty result: under `set -eo pipefail` a bare
# `MSG_ID=$(next_request_id)` would otherwise abort the whole loop silently the
# first time the lobby is down or hiccups, killing the worker with no log line.
# Fetching into a variable first keeps the curl failure out of a pipeline so it
# surfaces as this function's return code instead of a pipefail abort.
next_request_id() {
  local resp
  resp=$(curl -sf -X GET "$BASE_URL/api/system/ai-requests" \
    -H "Authorization: Bearer $(master_key)" 2>/dev/null) || return 1
  local candidates
  candidates=$(jq -r '
    def priority:
      if   . == "bug-report" then 0
      elif . == "feature-planning-request" or . == "feature-implementation-request" then 1
      elif . == "certification-request" then 3
      else 2 end;
    [.requests[] | select(.topic != "feature-request")]
      | sort_by(.topic | priority)
      | .[]
      | [.id, (.keywords.originalRequestor // .keywords.userName // .from // "")]
      | @tsv
  ' <<<"$resp" 2>/dev/null)
  local id requestor credits
  while IFS=$'\t' read -r id requestor; do
    [ -n "$id" ] || continue
    case "$requestor" in
      ai|admin|server|"") echo "$id"; return 0 ;;
    esac
    credits=$(requestor_credits "$requestor")
    if [ "$credits" -gt 0 ] 2>/dev/null; then
      echo "$id"
      return 0
    fi
    # tee's stdout must not leak into the captured result — send it to stderr.
    echo "[run-ai] Skipping $id: requestor '$requestor' has $credits credits; it stays queued until they top up." | tee -a "$LOG_FILE" >&2
  done <<<"$candidates"
  # No eligible request (queue empty or everything credit-blocked) — idle tick.
  return 0
}

# Resolve the long-lived headless-claude OAuth token the same way handle-mail
# does: prefer an already-exported CLAUDE_CODE_OAUTH_TOKEN, else read
# `claudeOauthToken` from ~/.meccg/secrets.json. Prints the token (empty if
# none found).
resolve_oauth_token() {
  if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    echo "$CLAUDE_CODE_OAUTH_TOKEN"
    return 0
  fi
  if [ -f "$SECRETS" ]; then
    jq -r '.claudeOauthToken // empty' "$SECRETS" 2>/dev/null
    return 0
  fi
}

# Print operator instructions for creating/refreshing the token. This is the
# one thing the loop cannot do for itself: `claude setup-token` is interactive
# (it opens a browser to log in with your Claude subscription), so an
# unattended worker can never mint a token headlessly — a human must run it
# once and stash the result where run-ai can find it.
print_token_help() {
  cat >&2 <<EOF
[run-ai] The headless claude needs a long-lived OAuth token (CLAUDE_CODE_OAUTH_TOKEN).
[run-ai] This cannot be created automatically — 'claude setup-token' opens a browser.
[run-ai] To set it up once:
[run-ai]   1. Run:  claude setup-token
[run-ai]            (log in with your Claude subscription when the browser opens)
[run-ai]   2. Copy the printed token (looks like 'sk-ant-oat...').
[run-ai]   3. Make it available to run-ai, either:
[run-ai]        - export CLAUDE_CODE_OAUTH_TOKEN=<token>            (current shell), or
[run-ai]        - add it to $SECRETS  as:  {"claudeOauthToken": "<token>"}
[run-ai]   4. Restart run-ai.
EOF
}

# Preflight: confirm a token exists and actually authenticates before entering
# the loop. Without this, a missing/expired token only surfaces as a 401 deep
# inside the first handle-mail run — after marking mail 'processing' and wasting
# a turn. We validate with one tiny headless prompt and read the stream-json
# output to decide. Exports the resolved token on success so child handle-mail
# processes inherit it. Returns non-zero (caller exits) if the token is missing
# or rejected.
preflight_token() {
  local tok
  tok=$(resolve_oauth_token)
  if [ -z "$tok" ]; then
    echo "[run-ai] ERROR: no CLAUDE_CODE_OAUTH_TOKEN set and no claudeOauthToken in $SECRETS." | tee -a "$LOG_FILE" >&2
    print_token_help
    return 1
  fi

  echo "[run-ai] Validating headless claude OAuth token..." | tee -a "$LOG_FILE"
  local tmp stats status verdict
  tmp=$(mktemp)
  stats=$(mktemp)

  # Supervision, the precise auth-marker patterns and the jq classification of
  # the terminal result all live in bin/claude-run now — this used to be a
  # third hand-rolled copy of that loop, and it was the ONLY copy carrying the
  # jq fix when the CLI reordered its result keys (handle-mail's copy did not,
  # and burned ~110 certifications).
  #
  # --early-auth-abort matters here specifically: a bad token never produces a
  # terminal result at all, so without it the check would sit out the whole
  # deadline before concluding anything. --grace 0 keeps the preflight snappy —
  # we have our answer the moment the result line lands.
  printf '%s' "Reply with the single word OK." \
    | CLAUDE_CODE_OAUTH_TOKEN="$tok" "$SCRIPT_DIR/claude-run" \
        --label run-ai-preflight \
        --timeout 120 \
        --grace 0 \
        --poll 2 \
        --early-auth-abort \
        --raw-log "$tmp" \
        --stats "$stats" \
        >/dev/null 2>>"$LOG_FILE" || true

  status=$(sed -n '3p' "$stats" 2>/dev/null || true)
  rm -f "$stats"

  # Anything that is neither a clean success nor a definite auth failure stays
  # "unknown": an inconclusive check must not block the operator.
  case "$status" in
    success) verdict="valid" ;;
    auth)    verdict="invalid" ;;
    *)       verdict="unknown" ;;
  esac

  case "$verdict" in
    valid)
      echo "[run-ai] Token OK." | tee -a "$LOG_FILE"
      export CLAUDE_CODE_OAUTH_TOKEN="$tok"
      rm -f "$tmp"
      return 0 ;;
    invalid)
      echo "[run-ai] ERROR: the OAuth token is invalid or expired (claude refused to authenticate)." | tee -a "$LOG_FILE" >&2
      tail -5 "$tmp" 2>/dev/null | sed 's/^/[run-ai]   /' >&2 || true
      print_token_help
      rm -f "$tmp"
      return 1 ;;
    *)
      # Couldn't get a clear answer (timeout/odd output). Don't block the
      # operator over an inconclusive check — proceed with the token we have.
      echo "[run-ai] WARNING: could not confirm token validity (verdict=$verdict). Proceeding with it anyway." | tee -a "$LOG_FILE" >&2
      export CLAUDE_CODE_OAUTH_TOKEN="$tok"
      rm -f "$tmp"
      return 0 ;;
  esac
}

IDLE_BACKOFF=(60 120 240 480 960 1920 3600)
idle_index=0

# Sleep on the idle-backoff schedule and advance the index, logging the given
# reason. Shared by every "nothing to do yet / can't reach X yet" branch so a
# transient outage (no pending work, lobby down, git remote unreachable) backs
# off and retries instead of spinning hot or dying under `set -e`.
idle_backoff() {
  local reason="$1"
  local delay="${IDLE_BACKOFF[$idle_index]}"
  echo "=== $reason at $(date -Iseconds), sleeping ${delay}s ===" | tee -a "$LOG_FILE"
  sleep "$delay"
  if [ "$idle_index" -lt $((${#IDLE_BACKOFF[@]} - 1)) ]; then
    idle_index=$((idle_index + 1))
  fi
}

# Validate the token up front — but WAIT for a usable one instead of exiting.
# This used to `exit 4`, which meant a token that was merely missing at boot (or
# briefly rejected while the API was overloaded) killed the worker outright and
# it stayed dead until a human noticed and restarted it. Now we back off and
# re-check on the idle schedule, so the worker resumes on its own the moment the
# operator drops a valid token in.
if ! preflight_token; then
  # One-shot mode is operator-driven and finite: waiting hours for a token that
  # only a human can fix would just hang the terminal. Fail fast instead.
  if [ "${#REQUEST_IDS[@]}" -gt 0 ]; then
    echo "=== Headless claude token unusable at $(date -Iseconds). Cannot handle the requested requests. ===" | tee -a "$LOG_FILE" >&2
    exit 4
  fi
  echo "=== Headless claude token unusable at $(date -Iseconds). Waiting for a usable token; run-ai will resume automatically. ===" | tee -a "$LOG_FILE" >&2
  until preflight_token; do
    idle_backoff "Headless claude token still unusable"
  done
  echo "=== Token usable again at $(date -Iseconds). Resuming. ===" | tee -a "$LOG_FILE"
fi
idle_index=0

# ---------------------------------------------------------------------------
# One-shot mode: handle exactly the named requests, then quit
# ---------------------------------------------------------------------------
# No polling, no PR sweep, no finalize sweep — those are the unattended loop's
# chores. This path exists to run (or re-run) a specific request on demand.
ONESHOT_LIMIT_RETRIES=3

if [ "${#REQUEST_IDS[@]}" -gt 0 ]; then
  cd "$SCRIPT_DIR/.."

  # Same reasoning as the loop's dirty-tree guard: leftovers from an earlier
  # skill would contaminate this request's branch. A human is at the keyboard
  # here, so say so and stop rather than parking.
  if [ -n "$(git status --porcelain)" ]; then
    echo "[run-ai] ERROR: working tree is dirty; refusing to handle requests on top of it." | tee -a "$LOG_FILE" >&2
    git status --porcelain | sed 's/^/[run-ai]   /' | tee -a "$LOG_FILE" >&2
    echo "[run-ai] Turn these files into a PR or revert them, then re-run." | tee -a "$LOG_FILE" >&2
    exit 3
  fi

  git checkout master 2>&1 | tee -a "$LOG_FILE"
  # A stale master is a lot better than not running the request at all, so an
  # unreachable remote is a warning here rather than the loop's back-off.
  if ! timeout 300 git pull 2>&1 | tee -a "$LOG_FILE"; then
    echo "[run-ai] WARNING: git pull failed (remote unreachable?); continuing on the local master." | tee -a "$LOG_FILE" >&2
  fi

  oneshot_failed=0
  oneshot_deferred=0
  for MSG_ID in "${REQUEST_IDS[@]}"; do
    iterations=$((iterations + 1))
    echo "=== Handling $MSG_ID at $(date -Iseconds) (one-shot ${iterations}/${#REQUEST_IDS[@]}) ===" | tee -a "$LOG_FILE"

    handle_rc=0
    run_request "$MSG_ID" || handle_rc=$?

    # Exit 5 is the API capacity/usage-limit signal: handle-mail reset the
    # message to 'new' (never burned) and stopped. Retry a bounded number of
    # times — unlike the loop we must not wait indefinitely, but a limit that
    # clears within a couple of backoff steps should not cost the operator a
    # re-run.
    attempt=1
    while [ "$handle_rc" -eq 5 ] && [ "$attempt" -lt "$ONESHOT_LIMIT_RETRIES" ]; do
      idle_backoff "API capacity/usage limit hit; $MSG_ID reset to 'new', retrying"
      attempt=$((attempt + 1))
      handle_rc=0
      run_request "$MSG_ID" || handle_rc=$?
    done

    if [ "$handle_rc" -eq 5 ]; then
      echo "=== $MSG_ID still capacity-blocked after $attempt attempt(s); left 'new' for a later run ===" | tee -a "$LOG_FILE"
      oneshot_deferred=1
      continue
    fi

    if [ "$handle_rc" -ne 0 ]; then
      echo "=== handle-mail failed for $MSG_ID (exit $handle_rc) at $(date -Iseconds). Marking it failed and continuing. ===" | tee -a "$LOG_FILE"
      force_failed_if_unresolved "$MSG_ID"
      oneshot_failed=1
      # A failed handler may have left the repo on its feature branch; the next
      # request must start from master like the loop's top-of-iteration does.
      git checkout master 2>&1 | tee -a "$LOG_FILE" || true
      continue
    fi

    echo "=== Finished $MSG_ID at $(date -Iseconds) ===" | tee -a "$LOG_FILE"
  done

  # Leave the repo where an idle loop would leave it: clean, on master.
  git checkout master 2>&1 | tee -a "$LOG_FILE" || true

  if [ "$oneshot_failed" -eq 1 ]; then
    echo "=== One-shot run finished at $(date -Iseconds) with failures. ===" | tee -a "$LOG_FILE"
    exit 1
  fi
  if [ "$oneshot_deferred" -eq 1 ]; then
    echo "=== One-shot run finished at $(date -Iseconds); at least one request deferred by an API capacity limit. ===" | tee -a "$LOG_FILE"
    exit 5
  fi
  echo "=== One-shot run complete (${#REQUEST_IDS[@]} request(s)) at $(date -Iseconds). ===" | tee -a "$LOG_FILE"
  exit 0
fi

while true; do
  # Refuse to keep looping on a dirty tree. A previous skill that
  # ended without committing would otherwise contaminate the next
  # run's branch. Stashing hides the problem — bail instead so the
  # operator has to convert the leftovers into a proper PR (or
  # revert) before restarting.
  cd "$SCRIPT_DIR/.."
  if [ -n "$(git status --porcelain)" ]; then
    # Leftovers from a skill that ended without committing would contaminate the
    # next run's branch, so we must not proceed — but we must not die either.
    # Discarding is not ours to decide (the leftovers may be real work), so we
    # park: log loudly, back off, and re-check. The operator converts them into
    # a PR or reverts them and the worker picks up again by itself, with no
    # restart needed.
    echo "=== Working tree dirty at $(date -Iseconds). Pausing until it is clean. ===" | tee -a "$LOG_FILE"
    git status --porcelain | sed 's/^/[run-ai]   /' | tee -a "$LOG_FILE"
    echo "[run-ai] Turn these files into a PR or revert them; run-ai will resume on its own." | tee -a "$LOG_FILE"
    idle_backoff "Working tree still dirty"
    continue
  fi

  git checkout master 2>&1 | tee -a "$LOG_FILE"

  # A failed pull means the git remote is unreachable (DNS/network hiccup,
  # remote restarting). That's transient, not fatal — back off and retry
  # rather than letting the `| tee` pipeline abort the loop under pipefail.
  # The `if !` guard both inverts the status and shields it from `set -e`;
  # with pipefail the pipeline reports git's failure (tee succeeds).
  # `timeout` because a stalled remote must fail the pull (and back off) rather
  # than hang the loop indefinitely.
  if ! timeout 300 git pull 2>&1 | tee -a "$LOG_FILE"; then
    idle_backoff "git pull failed (remote unreachable?)"
    continue
  fi

  # A failed poll means the lobby is unreachable (down, restarting, or a
  # transient network hiccup) — NOT that there is no work. Treat it like an
  # idle tick: back off and retry, rather than letting `set -e` abort the loop
  # with no message.
  if ! MSG_ID=$(next_request_id); then
    idle_backoff "Lobby unreachable"
    continue
  fi

  if [ -z "$MSG_ID" ]; then
    idle_backoff "No pending requests"
    continue
  fi

  idle_index=0
  iterations=$((iterations + 1))
  echo "=== Handling $MSG_ID at $(date -Iseconds) (iteration $iterations) ===" | tee -a "$LOG_FILE"

  # Exit 5 is the API-capacity/usage-limit signal: handle-mail detected a
  # session/usage limit, rate limit, or overload in the final stream-json result,
  # already reset the message to 'new' (NOT burned), and stopped. This is NOT a
  # failure to halt on — if we did, one limit hit would strand the whole queue.
  # Back off (escalating) and retry the SAME message later; the limit resets in
  # time. Any OTHER non-zero code is a real failure and halts as before.
  handle_rc=0
  run_request "$MSG_ID" || handle_rc=$?
  if [ "$handle_rc" -eq 5 ]; then
    # Don't let a capacity-blocked retry consume the --max-iterations budget.
    iterations=$((iterations - 1))
    idle_backoff "API capacity/usage limit hit; $MSG_ID reset to 'new', retrying later"
    continue
  elif [ "$handle_rc" -ne 0 ]; then
    # One bad request must not take the worker down with it. handle-mail owns
    # the message's final status and normally marks it 'failed' itself; if it
    # died before doing so the message would still be 'new'/'processing' and we
    # would pick the very same one again next tick and fail forever. So force it
    # terminal here, then carry on with the rest of the queue.
    echo "=== handle-mail failed for $MSG_ID (exit $handle_rc) at $(date -Iseconds). Marking it failed and continuing. ===" | tee -a "$LOG_FILE"
    force_failed_if_unresolved "$MSG_ID"
    idle_backoff "Recovering from handle-mail failure on $MSG_ID"
    continue
  fi
  echo "=== Finished $MSG_ID at $(date -Iseconds) ===" | tee -a "$LOG_FILE"
  echo
  echo
  echo
  if [ -n "$MAX_ITERATIONS" ] && [ "$iterations" -ge "$MAX_ITERATIONS" ]; then
    # The per-iteration `git checkout master` runs at the top of the loop, so
    # exiting here would strand the repo on the last skill's feature branch.
    # Return to master so the tree is left in the same known state an idle
    # loop would leave it (clean, on master).
    git checkout master 2>&1 | tee -a "$LOG_FILE"
    echo "=== Reached max iterations ($MAX_ITERATIONS) at $(date -Iseconds). Stopping run-ai. ===" | tee -a "$LOG_FILE"
    exit 0
  fi
  sleep 10
done
