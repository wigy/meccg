#!/bin/bash
set -eo pipefail

if [ $# -ge 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
  cat <<'EOF'
Usage: bin/run-ai [<n>]

Long-running worker loop that polls for unhandled ai requests and
dispatches them to bin/handle-mail one at a time. Pulls master between
iterations and skips feature-requests (which require human review).

Arguments:
  <n>             Optional maximum number of requests to handle, then exit.

Environment:
  MECCG_LOBBY_URL   Lobby base URL (default http://localhost:8080)
  MECCG_MASTER_KEY  Lobby master key. Falls back to
                    ~/.meccg/secrets.json when unset.

Options:
  -h, --help      Show this help message.
EOF
  exit 0
fi

MAX_ITERATIONS=""
if [ $# -ge 1 ] && [[ "$1" =~ ^[0-9]+$ ]]; then
  MAX_ITERATIONS="$1"
fi

iterations=0

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG_DIR="$HOME/.meccg/logs"
LOG_FILE="$LOG_DIR/ai.log"
SECRETS="$HOME/.meccg/secrets.json"
BASE_URL="${MECCG_LOBBY_URL:-http://localhost:8080}"
BASE_URL="${BASE_URL%/}"

mkdir -p "$LOG_DIR"

# Authenticate the spawned `claude` CLI for unattended runs. The interactive
# OAuth credentials in ~/.claude/.credentials.json use a short-lived access
# token with a rotating refresh token; in a headless loop that refresh
# eventually fails and every subsequent `claude -p` dies in ~5s with
# "API Error: 401 Invalid authentication credentials" (one run succeeds, the
# rest fail). A long-lived token from `claude setup-token` (export as
# CLAUDE_CODE_OAUTH_TOKEN, valid ~1 year) sidesteps that entirely. We prefer an
# already-exported env var, then fall back to `claudeOauthToken` in secrets.json.
if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ -f "$SECRETS" ]; then
  _oauth_token=$(jq -r '.claudeOauthToken // empty' "$SECRETS" 2>/dev/null)
  if [ -n "$_oauth_token" ]; then
    export CLAUDE_CODE_OAUTH_TOKEN="$_oauth_token"
    echo "[run-ai] Using CLAUDE_CODE_OAUTH_TOKEN from $SECRETS" | tee -a "$LOG_FILE"
  fi
  unset _oauth_token
fi
if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
  echo "[run-ai] WARNING: no CLAUDE_CODE_OAUTH_TOKEN (env or secrets.json 'claudeOauthToken')." | tee -a "$LOG_FILE"
  echo "[run-ai]   Falling back to ~/.claude/.credentials.json — the loop may hit 401" | tee -a "$LOG_FILE"
  echo "[run-ai]   after the access token expires. Run 'claude setup-token' and add the" | tee -a "$LOG_FILE"
  echo "[run-ai]   result to secrets.json as 'claudeOauthToken' to fix this." | tee -a "$LOG_FILE"
fi

master_key() {
  if [ -n "${MECCG_MASTER_KEY:-}" ]; then
    echo "$MECCG_MASTER_KEY"
    return 0
  fi
  if [ -f "$SECRETS" ]; then
    jq -r .masterKey "$SECRETS"
    return 0
  fi
  echo "[run-ai] ERROR: no master key (set MECCG_MASTER_KEY or provide $SECRETS)" >&2
  return 1
}

# Fetch unhandled requests from the lobby system API and print the first
# non-feature-request message ID. Feature-requests need human review
# (approve/decline) and cannot be auto-handled.
next_request_id() {
  curl -sf -X GET "$BASE_URL/api/system/ai-requests" \
    -H "Authorization: Bearer $(master_key)" 2>/dev/null \
    | jq -r '[.requests[] | select(.topic != "feature-request")][0].id // empty' 2>/dev/null
}

IDLE_BACKOFF=(60 120 240 480 960 1920 3600)
idle_index=0

while true; do
  # Refuse to keep looping on a dirty tree. A previous skill that
  # ended without committing would otherwise contaminate the next
  # run's branch. Stashing hides the problem — bail instead so the
  # operator has to convert the leftovers into a proper PR (or
  # revert) before restarting.
  cd "$SCRIPT_DIR/.."
  if [ -n "$(git status --porcelain)" ]; then
    echo "=== FATAL: working tree dirty at $(date -Iseconds). Stopping run-ai. ===" | tee -a "$LOG_FILE"
    git status --porcelain | sed 's/^/[run-ai]   /' | tee -a "$LOG_FILE"
    echo "[run-ai] Turn these files into a PR or revert them, then restart run-ai." | tee -a "$LOG_FILE"
    exit 2
  fi

  git checkout master 2>&1 | tee -a "$LOG_FILE"
  git pull 2>&1 | tee -a "$LOG_FILE"

  MSG_ID=$(next_request_id) || {
    echo "=== WARNING: next_request_id failed at $(date -Iseconds), will retry ===" | tee -a "$LOG_FILE"
    sleep 60
    continue
  }

  if [ -z "$MSG_ID" ]; then
    delay="${IDLE_BACKOFF[$idle_index]}"
    echo "=== No pending requests at $(date -Iseconds), sleeping ${delay}s ===" | tee -a "$LOG_FILE"
    sleep "$delay"
    if [ "$idle_index" -lt $((${#IDLE_BACKOFF[@]} - 1)) ]; then
      idle_index=$((idle_index + 1))
    fi
    continue
  fi

  idle_index=0
  iterations=$((iterations + 1))
  echo "=== Handling $MSG_ID at $(date -Iseconds) (iteration $iterations) ===" | tee -a "$LOG_FILE"
  if ! "$SCRIPT_DIR/handle-mail" "$MSG_ID" 2>&1 | tee -a "$LOG_FILE"; then
    echo "=== FATAL: handle-mail failed for $MSG_ID at $(date -Iseconds). Stopping run-ai. ===" | tee -a "$LOG_FILE"
    exit 3
  fi
  echo "=== Finished $MSG_ID at $(date -Iseconds) ===" | tee -a "$LOG_FILE"
  echo
  echo
  echo
  if [ -n "$MAX_ITERATIONS" ] && [ "$iterations" -ge "$MAX_ITERATIONS" ]; then
    echo "=== Reached max iterations ($MAX_ITERATIONS) at $(date -Iseconds). Stopping run-ai. ===" | tee -a "$LOG_FILE"
    exit 0
  fi
  sleep 10
done
