#!/bin/bash
set -eo pipefail

if [ $# -ge 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
  cat <<'EOF'
Usage: bin/run-ai [<n>]

Long-running worker loop that polls for unhandled ai requests and
dispatches them to bin/handle-mail one at a time. Pulls master between
iterations and skips feature-requests (which require human review).

At the start of every iteration it also sweeps all open PRs: for any PR
that conflicts with master, has failing CI checks, or carries review
comments it runs a headless claude to resolve the conflict, fix the CI
failure, and/or address the comments on that PR's branch. A PR is skipped
once its state (head commit, mergeable status, comment counts, failed-CI
count) is unchanged from the last pass, so an idle PR is not re-processed
every tick.

On startup it preflight-checks the headless claude OAuth token: it resolves
the token (env or secrets.json) and validates it with a tiny test prompt. If
the token is missing or expired it prints setup instructions and exits (code
4) instead of failing inside the first request. The token itself cannot be
created automatically — `claude setup-token` is interactive (browser login).

If handle-mail hits an API capacity/usage limit (subscription session limit,
rate limit, or server overload) mid-request, it resets that message to 'new'
(never burning it) and exits 5; run-ai treats 5 as retryable — it backs off on
the idle schedule and retries the same message later, once the limit resets,
instead of marching down the queue marking every request failed.

Arguments:
  <n>             Optional maximum number of requests to handle, then exit.

Environment:
  MECCG_LOBBY_URL   Lobby base URL (default http://localhost:8080)
  MECCG_MASTER_KEY  Lobby master key. Falls back to
                    ~/.meccg/secrets.json when unset.
  CLAUDE_CODE_OAUTH_TOKEN
                    Long-lived OAuth token (from `claude setup-token`) for the
                    headless claude. Falls back to `claudeOauthToken` in
                    ~/.meccg/secrets.json. Required so killing claude between
                    iterations does not invalidate the rotating subscription
                    token (which caused a 401 on every run after the first).

Options:
  -h, --help      Show this help message.
EOF
  exit 0
fi

MAX_ITERATIONS=""
if [ $# -ge 1 ] && [[ "$1" =~ ^[0-9]+$ ]]; then
  MAX_ITERATIONS="$1"
fi

iterations=0

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG_DIR="$HOME/.meccg/logs"
LOG_FILE="$LOG_DIR/ai.log"
SECRETS="$HOME/.meccg/secrets.json"
AI_INFO="$HOME/.meccg/players/ai/info.json"
BASE_URL="${MECCG_LOBBY_URL:-http://localhost:8080}"
BASE_URL="${BASE_URL%/}"

mkdir -p "$LOG_DIR"

master_key() {
  if [ -n "${MECCG_MASTER_KEY:-}" ]; then
    echo "$MECCG_MASTER_KEY"
    return 0
  fi
  if [ -f "$SECRETS" ]; then
    jq -r .masterKey "$SECRETS"
    return 0
  fi
  echo "[run-ai] ERROR: no master key (set MECCG_MASTER_KEY or provide $SECRETS)" >&2
  return 1
}

# Fetch unhandled requests from the lobby system API and print the first
# non-feature-request message ID. Feature-requests need human review
# (approve/decline) and cannot be auto-handled.
#
# Returns non-zero if the lobby could not be reached (curl failure). The caller
# MUST distinguish this from an empty result: under `set -eo pipefail` a bare
# `MSG_ID=$(next_request_id)` would otherwise abort the whole loop silently the
# first time the lobby is down or hiccups, killing the worker with no log line.
# Fetching into a variable first keeps the curl failure out of a pipeline so it
# surfaces as this function's return code instead of a pipefail abort.
next_request_id() {
  local resp
  resp=$(curl -sf -X GET "$BASE_URL/api/system/ai-requests" \
    -H "Authorization: Bearer $(master_key)" 2>/dev/null) || return 1
  jq -r '[.requests[] | select(.topic != "feature-request")][0].id // empty' <<<"$resp" 2>/dev/null
}

# Resolve the long-lived headless-claude OAuth token the same way handle-mail
# does: prefer an already-exported CLAUDE_CODE_OAUTH_TOKEN, else read
# `claudeOauthToken` from ~/.meccg/secrets.json. Prints the token (empty if
# none found).
resolve_oauth_token() {
  if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    echo "$CLAUDE_CODE_OAUTH_TOKEN"
    return 0
  fi
  if [ -f "$SECRETS" ]; then
    jq -r '.claudeOauthToken // empty' "$SECRETS" 2>/dev/null
    return 0
  fi
}

# Print operator instructions for creating/refreshing the token. This is the
# one thing the loop cannot do for itself: `claude setup-token` is interactive
# (it opens a browser to log in with your Claude subscription), so an
# unattended worker can never mint a token headlessly — a human must run it
# once and stash the result where run-ai can find it.
print_token_help() {
  cat >&2 <<EOF
[run-ai] The headless claude needs a long-lived OAuth token (CLAUDE_CODE_OAUTH_TOKEN).
[run-ai] This cannot be created automatically — 'claude setup-token' opens a browser.
[run-ai] To set it up once:
[run-ai]   1. Run:  claude setup-token
[run-ai]            (log in with your Claude subscription when the browser opens)
[run-ai]   2. Copy the printed token (looks like 'sk-ant-oat...').
[run-ai]   3. Make it available to run-ai, either:
[run-ai]        - export CLAUDE_CODE_OAUTH_TOKEN=<token>            (current shell), or
[run-ai]        - add it to $SECRETS  as:  {"claudeOauthToken": "<token>"}
[run-ai]   4. Restart run-ai.
EOF
}

# Preflight: confirm a token exists and actually authenticates before entering
# the loop. Without this, a missing/expired token only surfaces as a 401 deep
# inside the first handle-mail run — after marking mail 'processing' and wasting
# a turn. We validate with one tiny headless prompt and read the stream-json
# output to decide. Exports the resolved token on success so child handle-mail
# processes inherit it. Returns non-zero (caller exits) if the token is missing
# or rejected.
preflight_token() {
  local tok
  tok=$(resolve_oauth_token)
  if [ -z "$tok" ]; then
    echo "[run-ai] ERROR: no CLAUDE_CODE_OAUTH_TOKEN set and no claudeOauthToken in $SECRETS." | tee -a "$LOG_FILE" >&2
    print_token_help
    return 1
  fi

  echo "[run-ai] Validating headless claude OAuth token..." | tee -a "$LOG_FILE"
  local tmp
  tmp=$(mktemp)
  CLAUDE_CODE_OAUTH_TOKEN="$tok" claude --dangerously-skip-permissions \
    --output-format stream-json --verbose -p "Reply with the single word OK." \
    > "$tmp" 2>&1 &
  local pid=$!

  # Precise auth-failure markers. Deliberately NOT a bare "401": the
  # stream-json output is full of UUIDs/request-ids whose hex happens to
  # contain "401" (e.g. ...-ba7a-401e-...), which a loose pattern misreads as
  # a 401 and intermittently fails a perfectly good token. Each alternative
  # below requires structured context that only a real auth error produces.
  local auth_re='"status":[[:space:]]*401|authentication_error|"type":[[:space:]]*"error".*"type":[[:space:]]*"authentication|invalid (bearer token|api key|x-api-key|authentication credentials)|oauth token (has )?expired|please run.*(/login|setup-token)'

  local deadline=$(( $(date +%s) + 120 ))
  local verdict=""
  while kill -0 "$pid" 2>/dev/null; do
    # Wait for the terminal result line, then classify it below — don't try to
    # judge mid-stream (partial output is where the false positives live).
    if grep -q '"type":"result"' "$tmp" 2>/dev/null; then
      break
    fi
    if grep -qiE "$auth_re" "$tmp" 2>/dev/null; then
      verdict="invalid"; break
    fi
    if [ "$(date +%s)" -ge "$deadline" ]; then
      verdict="timeout"; break
    fi
    sleep 2
  done

  # claude is known to occasionally print its terminal result without exiting;
  # we've already decided, so stop it.
  kill -TERM "$pid" 2>/dev/null || true
  sleep 1
  kill -KILL "$pid" 2>/dev/null || true

  if [ -z "$verdict" ]; then
    # Trust the success marker first: a clean trivial reply means the token
    # authenticated, regardless of any incidental hex in the stream.
    if grep -q '"type":"result","subtype":"success","is_error":false' "$tmp" 2>/dev/null; then
      verdict="valid"
    elif grep -qiE "$auth_re" "$tmp" 2>/dev/null; then
      verdict="invalid"
    else
      verdict="unknown"
    fi
  fi

  case "$verdict" in
    valid)
      echo "[run-ai] Token OK." | tee -a "$LOG_FILE"
      export CLAUDE_CODE_OAUTH_TOKEN="$tok"
      rm -f "$tmp"
      return 0 ;;
    invalid)
      echo "[run-ai] ERROR: the OAuth token is invalid or expired (claude refused to authenticate)." | tee -a "$LOG_FILE" >&2
      grep -iE "$auth_re" "$tmp" 2>/dev/null | tail -3 | sed 's/^/[run-ai]   /' >&2 || true
      print_token_help
      rm -f "$tmp"
      return 1 ;;
    *)
      # Couldn't get a clear answer (timeout/odd output). Don't block the
      # operator over an inconclusive check — proceed with the token we have.
      echo "[run-ai] WARNING: could not confirm token validity (verdict=$verdict). Proceeding with it anyway." | tee -a "$LOG_FILE" >&2
      export CLAUDE_CODE_OAUTH_TOKEN="$tok"
      rm -f "$tmp"
      return 0 ;;
  esac
}

# Validate the token up front; abort with guidance if it's missing/expired.
if ! preflight_token; then
  echo "=== FATAL: headless claude token unusable at $(date -Iseconds). Stopping run-ai. ===" | tee -a "$LOG_FILE" >&2
  exit 4
fi

IDLE_BACKOFF=(60 120 240 480 960 1920 3600)
idle_index=0

# Sleep on the idle-backoff schedule and advance the index, logging the given
# reason. Shared by every "nothing to do yet / can't reach X yet" branch so a
# transient outage (no pending work, lobby down, git remote unreachable) backs
# off and retries instead of spinning hot or dying under `set -e`.
idle_backoff() {
  local reason="$1"
  local delay="${IDLE_BACKOFF[$idle_index]}"
  echo "=== $reason at $(date -Iseconds), sleeping ${delay}s ===" | tee -a "$LOG_FILE"
  sleep "$delay"
  if [ "$idle_index" -lt $((${#IDLE_BACKOFF[@]} - 1)) ]; then
    idle_index=$((idle_index + 1))
  fi
}

# ---------------------------------------------------------------------------
# Open-PR maintenance
# ---------------------------------------------------------------------------
# At the top of every loop iteration we sweep ALL open PRs and, for any PR that
# has a merge conflict or carries review feedback, hand it to a headless claude
# to resolve the conflict and/or address the comments on the PR's own branch.
# This keeps the review queue moving without waiting for a declined-review mail
# to arrive.
#
# Guardrails for an unattended loop:
#   - A per-process signature cache (PR_STATE_SIG) skips a PR whose head commit,
#     mergeable state, and comment/review counts are byte-identical to the last
#     time we processed it, so an unchanging PR is not re-fixed on every tick.
#     A fresh commit or a new comment changes the signature and re-triggers a
#     pass. This does not narrow the trigger (any conflict / any comment still
#     fires) — it only suppresses redundant re-runs on identical state.
#   - Failing to fix one PR never aborts the worker: we log, clean the tree,
#     and move on to the next PR / to mail handling.
declare -A PR_STATE_SIG

# Build the single-PR maintenance prompt handed to the headless claude.
#   $1=PR number  $2=PR url  $3=has_conflict(0/1)  $4=comment count  $5=failed-CI count
pr_fix_prompt() {
  local n="$1" url="$2" has_conflict="$3" total_comments="$4" failed_ci="$5"
  cat <<EOF
You are the MECCG unattended maintenance worker. Handle exactly ONE open pull request and then stop: PR #$n ($url). Work fully autonomously — never pause to ask for confirmation.

Context detected by the loop: mergeable-conflict=$([ "$has_conflict" -eq 1 ] && echo yes || echo no), comment/review-count=$total_comments, failed-CI-checks=$failed_ci.

Do the following:

1. Find the PR branch and check it out, then pull latest:
     BR=\$(gh pr view $n --json headRefName -q .headRefName)
     git checkout "\$BR" && git pull
2. RESOLVE CONFLICTS: if the PR conflicts with master (\`gh pr view $n --json mergeable -q .mergeable\` is CONFLICTING), merge origin/master into the branch and resolve every conflict correctly and conservatively:
     git fetch origin master && git merge origin/master
   Understand both sides before resolving; commit the merge. Never rebase, never amend, never force-push.
3. FIX FAILING CI: inspect the PR's CI checks and fix whatever is red:
     gh pr checks $n
     gh run view <run-id> --log-failed        # for the failing run's logs
   Reproduce each failure locally and fix the root cause in the code (a real type error, lint violation, or a genuinely failing test). Follow CLAUDE.md's test policy: to reproduce, run ONLY the failing/changed tests locally, NEVER the full \`npm test\` / \`npm run test:nightly\` suites — the full suites are what CI itself runs. Do not paper over a failure by weakening or deleting a test to make it pass; if a test failure reflects a real product bug, fix the product code.
4. ADDRESS COMMENTS: read all feedback on the PR — review summaries, issue comments, and inline code-line comments (resolve the repo with \`gh repo view --json nameWithOwner -q .nameWithOwner\`):
     gh pr view $n --json reviews,comments
     gh api "repos/<owner>/<repo>/pulls/$n/comments"
   Make code changes that address every actionable, unaddressed reviewer comment. SKIP comments that are already addressed, are your own bot/worker comments, or are not actionable requests.
5. If you changed any code, verify before pushing (follow CLAUDE.md — NEVER run the full \`npm test\` / \`npm run test:nightly\` suites, only changed tests):
     - npm run build
     - changed test files only: git diff --name-only origin/master...HEAD -- '*.test.ts' | xargs -r npx vitest run
     - npm run lint   (auto-fix with npm run lint:fix)
   Iterate until all pass.
6. Commit new commits on the SAME branch (never amend/rebase) and \`git push\`.
7. WORKING-TREE CONTRACT: your turn MUST end with a clean tree (\`git status --porcelain\` empty).
     - Success: everything committed on the branch and pushed.
     - Cannot resolve (ambiguous, needs architecture you can't do, tests won't pass): abort cleanly — \`git merge --abort\` if mid-merge, then \`git checkout -- .\` and delete any new files — leaving the tree clean and the PR untouched.
8. Do NOT send mail, do NOT change any mail message status, do NOT open a new PR, and do NOT merge the PR. Only push commits to the existing branch.

Finish with a single-line summary of what you did (or "nothing actionable") — nothing else.
EOF
}

# Run the headless claude on a single-PR maintenance prompt. Mirrors the
# background-watch pattern used by preflight_token (and handle-mail's
# run_skill): claude sometimes prints its terminal result without exiting, so
# we watch the stream-json output for the result line (or a timeout) and then
# make sure the process is gone. The OAuth token is already exported by
# preflight_token, so the child inherits it. Returns 0 if claude reached a
# terminal result, non-zero otherwise (caller only logs — never fatal).
run_pr_fix() {
  local prompt="$1"
  local tmp
  tmp=$(mktemp)
  ( cd "$SCRIPT_DIR/.." && claude --dangerously-skip-permissions \
      --output-format stream-json --verbose -p "$prompt" ) > "$tmp" 2>&1 &
  local pid=$!
  local deadline=$(( $(date +%s) + 1800 ))
  local done=0
  while kill -0 "$pid" 2>/dev/null; do
    if grep -q '"type":"result"' "$tmp" 2>/dev/null; then done=1; break; fi
    if [ "$(date +%s)" -ge "$deadline" ]; then break; fi
    sleep 5
  done
  kill -TERM "$pid" 2>/dev/null || true
  sleep 1
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$tmp"
  [ "$done" -eq 1 ]
}

# ---------------------------------------------------------------------------
# Finalize 'processed' messages by their pull-request outcome
# ---------------------------------------------------------------------------
# 'processed' is the INTERMEDIATE state handle-mail parks PR-backed work in: the
# handler finished and opened a PR, and stamped the PR URL (`prUrl`) plus the
# stashed requestor reply (`pendingReplyJson`) onto the message's keywords. Once
# per loop we resolve each such message from its PR's merge/close state:
#   - PR merged            → deliver the stashed reply, mark 'success'
#   - PR closed (unmerged) → notify the requestor it was declined, mark 'failed'
#   - PR still open        → leave 'processed' for a later tick
#   - no PR link           → mark 'failed' (a new-flow parked message should
#                            always carry one)
#
# The lobby reviewer's "approve" action can finalize the same message first —
# both finalizers move the ORIGINAL message to a terminal 'success'/'failed' and
# act only while it is still 'processed', and the lobby approve handler skips its
# send when the message is already terminal, so the reply is never sent twice.
#
# We only touch messages carrying `pendingReplyJson` (i.e. parked by the CURRENT
# handle-mail). Legacy 'processed' messages from before this feature lack it and
# are left untouched, so historically-successful work is never re-flagged failed.
ai_display_name() {
  if [ -f "$AI_INFO" ]; then jq -r '.displayName // "ai"' "$AI_INFO" 2>/dev/null || echo ai; else echo ai; fi
}

# PUT a terminal status on an ai-inbox message.  $1=msg-id  $2=status
finalize_set_status() {
  curl -sf -X PUT "$BASE_URL/api/system/mail/ai/$1" \
    -H "Authorization: Bearer $(master_key)" \
    -H 'Content-Type: application/json' \
    -d "{\"status\":\"$2\"}" >/dev/null 2>&1 \
    || echo "[run-ai] WARNING: failed to set message $1 -> $2" | tee -a "$LOG_FILE"
}

# POST a mail payload (built from a pendingReplyJson object).  $1=json-payload
finalize_send_mail() {
  curl -sf -X POST "$BASE_URL/api/system/mail" \
    -H "Authorization: Bearer $(master_key)" \
    -H 'Content-Type: application/json' \
    -d "$1" >/dev/null 2>&1 \
    || echo "[run-ai] WARNING: failed to send finalize mail" | tee -a "$LOG_FILE"
}

finalize_processed_messages() {
  local resp
  if ! resp=$(curl -sf -X GET "$BASE_URL/api/system/ai-requests?all=true" \
      -H "Authorization: Bearer $(master_key)" 2>/dev/null); then
    echo "=== Could not list processed messages (lobby unreachable) at $(date -Iseconds); skipping finalize ===" | tee -a "$LOG_FILE"
    return 0
  fi

  local processed count
  processed=$(jq -c '[.requests[] | select(.status == "processed") | select((.keywords.pendingReplyJson // "") != "")]' <<<"$resp" 2>/dev/null || echo '[]')
  count=$(jq 'length' <<<"$processed" 2>/dev/null || echo 0)
  if [ "$count" -eq 0 ]; then
    return 0
  fi
  echo "=== Finalize sweep: $count processed message(s) awaiting a PR decision at $(date -Iseconds) ===" | tee -a "$LOG_FILE"

  local from_name
  from_name=$(ai_display_name)

  cd "$SCRIPT_DIR/.."
  local row id pr_url pending pr_json state
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    id=$(jq -r '.id' <<<"$row" 2>/dev/null || echo "")
    pr_url=$(jq -r '.keywords.prUrl // empty' <<<"$row" 2>/dev/null || echo "")
    pending=$(jq -c '.keywords.pendingReplyJson | fromjson? // empty' <<<"$row" 2>/dev/null || echo "")
    [ -n "$id" ] || continue

    if [ -z "$pr_url" ]; then
      echo "=== Finalize: $id has no PR link -> failed ===" | tee -a "$LOG_FILE"
      finalize_set_status "$id" failed
      continue
    fi

    # Resolve the PR's merge/close state. A gh hiccup on one PR just defers it.
    # `state` is OPEN/MERGED/CLOSED and stable across gh versions; the older
    # `merged` boolean field was removed, so relying on it made this whole call
    # fail and every message got deferred forever.
    if ! pr_json=$(gh pr view "$pr_url" --json state 2>/dev/null); then
      echo "=== Finalize: $id PR $pr_url unreadable (gh); deferring ===" | tee -a "$LOG_FILE"
      continue
    fi
    state=$(jq -r '.state // ""' <<<"$pr_json" 2>/dev/null || echo "")

    if [ "$state" = "MERGED" ]; then
      echo "=== Finalize: $id PR merged -> success (delivering reply) ===" | tee -a "$LOG_FILE"
      if [ -n "$pending" ]; then
        finalize_send_mail "$(jq -nc --arg from "$from_name" --argjson p "$pending" \
          '{recipients: [$p.recipient], from: $from, sender: "ai", topic: $p.topic,
            subject: $p.subject, body: $p.body, keywords: ($p.keywords // {}),
            replyTo: ($p.replyTo // null), sentBy: "ai"}')"
      fi
      finalize_set_status "$id" success
    elif [ "$state" = "CLOSED" ]; then
      echo "=== Finalize: $id PR closed unmerged -> failed (notifying) ===" | tee -a "$LOG_FILE"
      if [ -n "$pending" ]; then
        finalize_send_mail "$(jq -nc --arg from "$from_name" --argjson p "$pending" \
          '{recipients: [$p.recipient], from: $from, sender: "ai", topic: $p.topic,
            subject: ("Declined: " + $p.subject),
            body: ("The pull request for this request was closed without being merged, so the change was not applied. If you still need it, please re-submit the request.\n\n---\n\n" + $p.body),
            keywords: ($p.keywords // {}), replyTo: ($p.replyTo // null), sentBy: "ai"}')"
      fi
      finalize_set_status "$id" failed
    fi
    # OPEN (or a merge not yet reflected) — leave 'processed' for a later tick.
  done < <(jq -c '.[]' <<<"$processed")
}

# Sweep every open PR once. For each PR that conflicts with master or carries
# reviewer feedback, run the single-PR fixer. Always returns 0 — a failure on
# any one PR is logged and skipped so the worker keeps running. Leaves the repo
# on master with a clean tree.
handle_open_prs() {
  cd "$SCRIPT_DIR/.."

  # gh failing (network/auth) is transient — skip the sweep this tick rather
  # than aborting the loop.
  local prs
  if ! prs=$(gh pr list --state open --limit 200 --json number,url 2>/dev/null); then
    echo "=== Could not list open PRs (gh unavailable) at $(date -Iseconds); skipping PR sweep ===" | tee -a "$LOG_FILE"
    return 0
  fi

  local count
  count=$(jq 'length' <<<"$prs" 2>/dev/null || echo 0)
  if [ "$count" -eq 0 ]; then
    echo "=== PR sweep: no open PRs at $(date -Iseconds) ===" | tee -a "$LOG_FILE"
    return 0
  fi

  # Visible heartbeat so the sweep is observable every iteration, even when no
  # PR needs work (a PR that is mergeable with no comments is skipped silently
  # below, so without this line a working sweep looks like it never ran).
  echo "=== PR sweep: checking $count open PR(s) for conflicts/comments at $(date -Iseconds) ===" | tee -a "$LOG_FILE"

  local repo
  repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)

  local n url
  while IFS=$'\t' read -r n url; do
    if [ -z "$n" ]; then
      continue
    fi

    # Per-PR detail: mergeable state, review decision, and comment/review
    # counts. A gh hiccup on one PR just skips that PR.
    local detail mergeable review_decision issue_comments review_bodies head_oid failed_ci
    if ! detail=$(gh pr view "$n" --json mergeable,reviewDecision,comments,reviews,headRefOid,statusCheckRollup 2>/dev/null); then
      continue
    fi
    mergeable=$(jq -r '.mergeable // "UNKNOWN"' <<<"$detail" 2>/dev/null || echo UNKNOWN)
    review_decision=$(jq -r '.reviewDecision // ""' <<<"$detail" 2>/dev/null || echo "")
    issue_comments=$(jq '[.comments[]? | select((.body // "") != "")] | length' <<<"$detail" 2>/dev/null || echo 0)
    review_bodies=$(jq '[.reviews[]? | select((.body // "") != "")] | length' <<<"$detail" 2>/dev/null || echo 0)
    head_oid=$(jq -r '.headRefOid // ""' <<<"$detail" 2>/dev/null || echo "")

    # Count definitively-failed CI checks (a CheckRun exposes .conclusion, a
    # legacy StatusContext exposes .state). Only terminal failures count —
    # PENDING/IN_PROGRESS checks are still running and are left alone.
    failed_ci=$(jq '[.statusCheckRollup[]? | (.conclusion // .state // "")
      | select(. == "FAILURE" or . == "ERROR" or . == "CANCELLED"
             or . == "TIMED_OUT" or . == "STARTUP_FAILURE" or . == "ACTION_REQUIRED")]
      | length' <<<"$detail" 2>/dev/null || echo 0)

    # Inline (code-line) review comments live outside `gh pr view`; count them
    # via the REST API so "there are comments" also covers line comments.
    local inline_comments=0
    if [ -n "$repo" ]; then
      inline_comments=$(gh api "repos/$repo/pulls/$n/comments" -q 'length' 2>/dev/null || echo 0)
    fi

    local total_comments=$(( issue_comments + review_bodies + inline_comments ))
    local has_conflict=0
    if [ "$mergeable" = "CONFLICTING" ]; then
      has_conflict=1
    fi

    # Nothing to do: no conflict, no comments, no failed CI.
    if [ "$has_conflict" -eq 0 ] && [ "$total_comments" -eq 0 ] && [ "$failed_ci" -eq 0 ]; then
      continue
    fi

    # Skip if this exact state was already processed in this run.
    local sig="${head_oid}:${mergeable}:${total_comments}:${review_decision}:${failed_ci}"
    if [ "${PR_STATE_SIG[$n]:-}" = "$sig" ]; then
      continue
    fi

    echo "=== PR #$n needs attention (conflict=$has_conflict, comments=$total_comments, failed-ci=$failed_ci) at $(date -Iseconds) ===" | tee -a "$LOG_FILE"
    if run_pr_fix "$(pr_fix_prompt "$n" "$url" "$has_conflict" "$total_comments" "$failed_ci")"; then
      echo "=== PR #$n sweep done at $(date -Iseconds) ===" | tee -a "$LOG_FILE"
    else
      echo "=== WARNING: PR #$n sweep did not reach a terminal result at $(date -Iseconds) ===" | tee -a "$LOG_FILE"
    fi

    # Record the state we acted on (re-reading the head, which may have moved
    # if claude pushed) so an otherwise-unchanged PR is not re-processed on the
    # next tick.
    local new_head
    new_head=$(gh pr view "$n" --json headRefOid -q .headRefOid 2>/dev/null || echo "$head_oid")
    PR_STATE_SIG[$n]="${new_head}:${mergeable}:${total_comments}:${review_decision}:${failed_ci}"

    # Backstop: claude must leave the tree clean, but if a run died mid-merge
    # we clean up here so the loop's top-of-iteration dirty-tree guard does not
    # fatally halt the whole worker. No `reset --hard` / rebase — git policy.
    cd "$SCRIPT_DIR/.."
    if [ -n "$(git status --porcelain)" ]; then
      echo "[run-ai] PR #$n left a dirty tree; aborting any in-progress merge and discarding leftovers." | tee -a "$LOG_FILE"
      git merge --abort 2>/dev/null || true
      git checkout -- . 2>/dev/null || true
      git clean -fd 2>/dev/null || true
    fi
    git checkout master 2>&1 | tee -a "$LOG_FILE" || true
  done < <(jq -r '.[] | "\(.number)\t\(.url)"' <<<"$prs")

  # Always end the sweep back on master.
  cd "$SCRIPT_DIR/.."
  git checkout master 2>&1 | tee -a "$LOG_FILE" || true
  return 0
}

while true; do
  # Refuse to keep looping on a dirty tree. A previous skill that
  # ended without committing would otherwise contaminate the next
  # run's branch. Stashing hides the problem — bail instead so the
  # operator has to convert the leftovers into a proper PR (or
  # revert) before restarting.
  cd "$SCRIPT_DIR/.."
  if [ -n "$(git status --porcelain)" ]; then
    echo "=== FATAL: working tree dirty at $(date -Iseconds). Stopping run-ai. ===" | tee -a "$LOG_FILE"
    git status --porcelain | sed 's/^/[run-ai]   /' | tee -a "$LOG_FILE"
    echo "[run-ai] Turn these files into a PR or revert them, then restart run-ai." | tee -a "$LOG_FILE"
    exit 2
  fi

  git checkout master 2>&1 | tee -a "$LOG_FILE"

  # A failed pull means the git remote is unreachable (DNS/network hiccup,
  # remote restarting). That's transient, not fatal — back off and retry
  # rather than letting the `| tee` pipeline abort the loop under pipefail.
  # The `if !` guard both inverts the status and shields it from `set -e`;
  # with pipefail the pipeline reports git's failure (tee succeeds).
  if ! git pull 2>&1 | tee -a "$LOG_FILE"; then
    idle_backoff "git pull failed (remote unreachable?)"
    continue
  fi

  # Sweep all open PRs before touching mail: resolve merge conflicts and
  # address review comments on each PR's own branch. Never fatal — handle_open_prs
  # logs and skips any PR it can't fix, and always returns to master clean.
  handle_open_prs || true

  # Finalize any 'processed' messages whose PR has since merged or closed:
  # deliver the stashed reply + mark 'success', or notify + mark 'failed'. Never
  # fatal — logs and skips anything it can't resolve, leaving it for a later tick.
  finalize_processed_messages || true

  # A failed poll means the lobby is unreachable (down, restarting, or a
  # transient network hiccup) — NOT that there is no work. Treat it like an
  # idle tick: back off and retry, rather than letting `set -e` abort the loop
  # with no message.
  if ! MSG_ID=$(next_request_id); then
    idle_backoff "Lobby unreachable"
    continue
  fi

  if [ -z "$MSG_ID" ]; then
    idle_backoff "No pending requests"
    continue
  fi

  idle_index=0
  iterations=$((iterations + 1))
  echo "=== Handling $MSG_ID at $(date -Iseconds) (iteration $iterations) ===" | tee -a "$LOG_FILE"
  # Capture handle-mail's OWN exit code through the tee pipeline (PIPESTATUS[0];
  # tee always succeeds, so under pipefail the pipeline status is handle-mail's).
  # Wrapping in `if` also shields the pipeline from `set -e`.
  #
  # Exit 5 is the API-capacity/usage-limit signal: handle-mail detected a
  # session/usage limit, rate limit, or overload in the final stream-json result,
  # already reset the message to 'new' (NOT burned), and stopped. This is NOT a
  # failure to halt on — if we did, one limit hit would strand the whole queue.
  # Back off (escalating) and retry the SAME message later; the limit resets in
  # time. Any OTHER non-zero code is a real failure and halts as before.
  handle_rc=0
  if "$SCRIPT_DIR/handle-mail" "$MSG_ID" 2>&1 | tee -a "$LOG_FILE"; then
    handle_rc=0
  else
    handle_rc=${PIPESTATUS[0]}
  fi
  if [ "$handle_rc" -eq 5 ]; then
    # Don't let a capacity-blocked retry consume the --max-iterations budget.
    iterations=$((iterations - 1))
    idle_backoff "API capacity/usage limit hit; $MSG_ID reset to 'new', retrying later"
    continue
  elif [ "$handle_rc" -ne 0 ]; then
    echo "=== FATAL: handle-mail failed for $MSG_ID at $(date -Iseconds). Stopping run-ai. ===" | tee -a "$LOG_FILE"
    exit 3
  fi
  echo "=== Finished $MSG_ID at $(date -Iseconds) ===" | tee -a "$LOG_FILE"
  echo
  echo
  echo
  if [ -n "$MAX_ITERATIONS" ] && [ "$iterations" -ge "$MAX_ITERATIONS" ]; then
    # The per-iteration `git checkout master` runs at the top of the loop, so
    # exiting here would strand the repo on the last skill's feature branch.
    # Return to master so the tree is left in the same known state an idle
    # loop would leave it (clean, on master).
    git checkout master 2>&1 | tee -a "$LOG_FILE"
    echo "=== Reached max iterations ($MAX_ITERATIONS) at $(date -Iseconds). Stopping run-ai. ===" | tee -a "$LOG_FILE"
    exit 0
  fi
  sleep 10
done
