#!/bin/bash
set -eo pipefail

if [ $# -ge 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
  cat <<'EOF'
Usage: bin/run-ai [<n>]

Long-running worker loop that polls for unhandled ai requests and
dispatches them to bin/handle-mail one at a time. Pulls master between
iterations and skips feature-requests (which require human review).

On startup it preflight-checks the headless claude OAuth token: it resolves
the token (env or secrets.json) and validates it with a tiny test prompt. If
the token is missing or expired it prints setup instructions and exits (code
4) instead of failing inside the first request. The token itself cannot be
created automatically — `claude setup-token` is interactive (browser login).

Arguments:
  <n>             Optional maximum number of requests to handle, then exit.

Environment:
  MECCG_LOBBY_URL   Lobby base URL (default http://localhost:8080)
  MECCG_MASTER_KEY  Lobby master key. Falls back to
                    ~/.meccg/secrets.json when unset.
  CLAUDE_CODE_OAUTH_TOKEN
                    Long-lived OAuth token (from `claude setup-token`) for the
                    headless claude. Falls back to `claudeOauthToken` in
                    ~/.meccg/secrets.json. Required so killing claude between
                    iterations does not invalidate the rotating subscription
                    token (which caused a 401 on every run after the first).

Options:
  -h, --help      Show this help message.
EOF
  exit 0
fi

MAX_ITERATIONS=""
if [ $# -ge 1 ] && [[ "$1" =~ ^[0-9]+$ ]]; then
  MAX_ITERATIONS="$1"
fi

iterations=0

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG_DIR="$HOME/.meccg/logs"
LOG_FILE="$LOG_DIR/ai.log"
SECRETS="$HOME/.meccg/secrets.json"
BASE_URL="${MECCG_LOBBY_URL:-http://localhost:8080}"
BASE_URL="${BASE_URL%/}"

mkdir -p "$LOG_DIR"

master_key() {
  if [ -n "${MECCG_MASTER_KEY:-}" ]; then
    echo "$MECCG_MASTER_KEY"
    return 0
  fi
  if [ -f "$SECRETS" ]; then
    jq -r .masterKey "$SECRETS"
    return 0
  fi
  echo "[run-ai] ERROR: no master key (set MECCG_MASTER_KEY or provide $SECRETS)" >&2
  return 1
}

# Fetch unhandled requests from the lobby system API and print the first
# non-feature-request message ID. Feature-requests need human review
# (approve/decline) and cannot be auto-handled.
#
# Returns non-zero if the lobby could not be reached (curl failure). The caller
# MUST distinguish this from an empty result: under `set -eo pipefail` a bare
# `MSG_ID=$(next_request_id)` would otherwise abort the whole loop silently the
# first time the lobby is down or hiccups, killing the worker with no log line.
# Fetching into a variable first keeps the curl failure out of a pipeline so it
# surfaces as this function's return code instead of a pipefail abort.
next_request_id() {
  local resp
  resp=$(curl -sf -X GET "$BASE_URL/api/system/ai-requests" \
    -H "Authorization: Bearer $(master_key)" 2>/dev/null) || return 1
  jq -r '[.requests[] | select(.topic != "feature-request")][0].id // empty' <<<"$resp" 2>/dev/null
}

# Resolve the long-lived headless-claude OAuth token the same way handle-mail
# does: prefer an already-exported CLAUDE_CODE_OAUTH_TOKEN, else read
# `claudeOauthToken` from ~/.meccg/secrets.json. Prints the token (empty if
# none found).
resolve_oauth_token() {
  if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    echo "$CLAUDE_CODE_OAUTH_TOKEN"
    return 0
  fi
  if [ -f "$SECRETS" ]; then
    jq -r '.claudeOauthToken // empty' "$SECRETS" 2>/dev/null
    return 0
  fi
}

# Print operator instructions for creating/refreshing the token. This is the
# one thing the loop cannot do for itself: `claude setup-token` is interactive
# (it opens a browser to log in with your Claude subscription), so an
# unattended worker can never mint a token headlessly — a human must run it
# once and stash the result where run-ai can find it.
print_token_help() {
  cat >&2 <<EOF
[run-ai] The headless claude needs a long-lived OAuth token (CLAUDE_CODE_OAUTH_TOKEN).
[run-ai] This cannot be created automatically — 'claude setup-token' opens a browser.
[run-ai] To set it up once:
[run-ai]   1. Run:  claude setup-token
[run-ai]            (log in with your Claude subscription when the browser opens)
[run-ai]   2. Copy the printed token (looks like 'sk-ant-oat...').
[run-ai]   3. Make it available to run-ai, either:
[run-ai]        - export CLAUDE_CODE_OAUTH_TOKEN=<token>            (current shell), or
[run-ai]        - add it to $SECRETS  as:  {"claudeOauthToken": "<token>"}
[run-ai]   4. Restart run-ai.
EOF
}

# Preflight: confirm a token exists and actually authenticates before entering
# the loop. Without this, a missing/expired token only surfaces as a 401 deep
# inside the first handle-mail run — after marking mail 'processing' and wasting
# a turn. We validate with one tiny headless prompt and read the stream-json
# output to decide. Exports the resolved token on success so child handle-mail
# processes inherit it. Returns non-zero (caller exits) if the token is missing
# or rejected.
preflight_token() {
  local tok
  tok=$(resolve_oauth_token)
  if [ -z "$tok" ]; then
    echo "[run-ai] ERROR: no CLAUDE_CODE_OAUTH_TOKEN set and no claudeOauthToken in $SECRETS." | tee -a "$LOG_FILE" >&2
    print_token_help
    return 1
  fi

  echo "[run-ai] Validating headless claude OAuth token..." | tee -a "$LOG_FILE"
  local tmp
  tmp=$(mktemp)
  CLAUDE_CODE_OAUTH_TOKEN="$tok" claude --dangerously-skip-permissions \
    --output-format stream-json --verbose -p "Reply with the single word OK." \
    > "$tmp" 2>&1 &
  local pid=$!

  # Precise auth-failure markers. Deliberately NOT a bare "401": the
  # stream-json output is full of UUIDs/request-ids whose hex happens to
  # contain "401" (e.g. ...-ba7a-401e-...), which a loose pattern misreads as
  # a 401 and intermittently fails a perfectly good token. Each alternative
  # below requires structured context that only a real auth error produces.
  local auth_re='"status":[[:space:]]*401|authentication_error|"type":[[:space:]]*"error".*"type":[[:space:]]*"authentication|invalid (bearer token|api key|x-api-key|authentication credentials)|oauth token (has )?expired|please run.*(/login|setup-token)'

  local deadline=$(( $(date +%s) + 120 ))
  local verdict=""
  while kill -0 "$pid" 2>/dev/null; do
    # Wait for the terminal result line, then classify it below — don't try to
    # judge mid-stream (partial output is where the false positives live).
    if grep -q '"type":"result"' "$tmp" 2>/dev/null; then
      break
    fi
    if grep -qiE "$auth_re" "$tmp" 2>/dev/null; then
      verdict="invalid"; break
    fi
    if [ "$(date +%s)" -ge "$deadline" ]; then
      verdict="timeout"; break
    fi
    sleep 2
  done

  # claude is known to occasionally print its terminal result without exiting;
  # we've already decided, so stop it.
  kill -TERM "$pid" 2>/dev/null || true
  sleep 1
  kill -KILL "$pid" 2>/dev/null || true

  if [ -z "$verdict" ]; then
    # Trust the success marker first: a clean trivial reply means the token
    # authenticated, regardless of any incidental hex in the stream.
    if grep -q '"type":"result","subtype":"success","is_error":false' "$tmp" 2>/dev/null; then
      verdict="valid"
    elif grep -qiE "$auth_re" "$tmp" 2>/dev/null; then
      verdict="invalid"
    else
      verdict="unknown"
    fi
  fi

  case "$verdict" in
    valid)
      echo "[run-ai] Token OK." | tee -a "$LOG_FILE"
      export CLAUDE_CODE_OAUTH_TOKEN="$tok"
      rm -f "$tmp"
      return 0 ;;
    invalid)
      echo "[run-ai] ERROR: the OAuth token is invalid or expired (claude refused to authenticate)." | tee -a "$LOG_FILE" >&2
      grep -iE "$auth_re" "$tmp" 2>/dev/null | tail -3 | sed 's/^/[run-ai]   /' >&2 || true
      print_token_help
      rm -f "$tmp"
      return 1 ;;
    *)
      # Couldn't get a clear answer (timeout/odd output). Don't block the
      # operator over an inconclusive check — proceed with the token we have.
      echo "[run-ai] WARNING: could not confirm token validity (verdict=$verdict). Proceeding with it anyway." | tee -a "$LOG_FILE" >&2
      export CLAUDE_CODE_OAUTH_TOKEN="$tok"
      rm -f "$tmp"
      return 0 ;;
  esac
}

# Validate the token up front; abort with guidance if it's missing/expired.
if ! preflight_token; then
  echo "=== FATAL: headless claude token unusable at $(date -Iseconds). Stopping run-ai. ===" | tee -a "$LOG_FILE" >&2
  exit 4
fi

IDLE_BACKOFF=(60 120 240 480 960 1920 3600)
idle_index=0

# Sleep on the idle-backoff schedule and advance the index, logging the given
# reason. Shared by every "nothing to do yet / can't reach X yet" branch so a
# transient outage (no pending work, lobby down, git remote unreachable) backs
# off and retries instead of spinning hot or dying under `set -e`.
idle_backoff() {
  local reason="$1"
  local delay="${IDLE_BACKOFF[$idle_index]}"
  echo "=== $reason at $(date -Iseconds), sleeping ${delay}s ===" | tee -a "$LOG_FILE"
  sleep "$delay"
  if [ "$idle_index" -lt $((${#IDLE_BACKOFF[@]} - 1)) ]; then
    idle_index=$((idle_index + 1))
  fi
}

while true; do
  # Refuse to keep looping on a dirty tree. A previous skill that
  # ended without committing would otherwise contaminate the next
  # run's branch. Stashing hides the problem — bail instead so the
  # operator has to convert the leftovers into a proper PR (or
  # revert) before restarting.
  cd "$SCRIPT_DIR/.."
  if [ -n "$(git status --porcelain)" ]; then
    echo "=== FATAL: working tree dirty at $(date -Iseconds). Stopping run-ai. ===" | tee -a "$LOG_FILE"
    git status --porcelain | sed 's/^/[run-ai]   /' | tee -a "$LOG_FILE"
    echo "[run-ai] Turn these files into a PR or revert them, then restart run-ai." | tee -a "$LOG_FILE"
    exit 2
  fi

  git checkout master 2>&1 | tee -a "$LOG_FILE"

  # A failed pull means the git remote is unreachable (DNS/network hiccup,
  # remote restarting). That's transient, not fatal — back off and retry
  # rather than letting the `| tee` pipeline abort the loop under pipefail.
  # The `if !` guard both inverts the status and shields it from `set -e`;
  # with pipefail the pipeline reports git's failure (tee succeeds).
  if ! git pull 2>&1 | tee -a "$LOG_FILE"; then
    idle_backoff "git pull failed (remote unreachable?)"
    continue
  fi

  # A failed poll means the lobby is unreachable (down, restarting, or a
  # transient network hiccup) — NOT that there is no work. Treat it like an
  # idle tick: back off and retry, rather than letting `set -e` abort the loop
  # with no message.
  if ! MSG_ID=$(next_request_id); then
    idle_backoff "Lobby unreachable"
    continue
  fi

  if [ -z "$MSG_ID" ]; then
    idle_backoff "No pending requests"
    continue
  fi

  idle_index=0
  iterations=$((iterations + 1))
  echo "=== Handling $MSG_ID at $(date -Iseconds) (iteration $iterations) ===" | tee -a "$LOG_FILE"
  if ! "$SCRIPT_DIR/handle-mail" "$MSG_ID" 2>&1 | tee -a "$LOG_FILE"; then
    echo "=== FATAL: handle-mail failed for $MSG_ID at $(date -Iseconds). Stopping run-ai. ===" | tee -a "$LOG_FILE"
    exit 3
  fi
  echo "=== Finished $MSG_ID at $(date -Iseconds) ===" | tee -a "$LOG_FILE"
  echo
  echo
  echo
  if [ -n "$MAX_ITERATIONS" ] && [ "$iterations" -ge "$MAX_ITERATIONS" ]; then
    # The per-iteration `git checkout master` runs at the top of the loop, so
    # exiting here would strand the repo on the last skill's feature branch.
    # Return to master so the tree is left in the same known state an idle
    # loop would leave it (clean, on master).
    git checkout master 2>&1 | tee -a "$LOG_FILE"
    echo "=== Reached max iterations ($MAX_ITERATIONS) at $(date -Iseconds). Stopping run-ai. ===" | tee -a "$LOG_FILE"
    exit 0
  fi
  sleep 10
done
